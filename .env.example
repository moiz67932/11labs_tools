# Backend-only secret. Legacy Supabase service-role JWT OR new sb_secret_ key.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=PASTE_SERVER_ONLY_KEY

# Create with: python3 -c 'import secrets;print(secrets.token_urlsafe(40))'
PORTIVE_TOOL_API_KEY=GENERATE_YOUR_RANDOM_SECRET

# Required only for send_portive_overview
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Bare address of the Gmail account authorized locally (no display name).
GMAIL_SENDER_EMAIL=
# Optional; defaults to GMAIL_SENDER_EMAIL.
GMAIL_REPLY_TO=
BUSINESS_POSTAL_ADDRESS=YOUR_REAL_BUSINESS_POSTAL_ADDRESS
PUBLIC_BASE_URL=https://YOUR_HTTPS_BACKEND_DOMAIN
UNSUBSCRIBE_SIGNING_SECRET=GENERATE_ANOTHER_RANDOM_SECRET

# ElevenLabs Portive SALES webhooks only. Never place these in a prompt or CSV.
PORTIVE_WEBHOOK_ENABLED=true
PORTIVE_INITIATION_SECRET=GENERATE_A_DISTINCT_RANDOM_SECRET
ELEVENLABS_POSTCALL_WEBHOOK_SECRET=PASTE_ELEVENLABS_GENERATED_HMAC_SECRET
# Needed by the ElevenLabs SDK client constructor; keep server-only.
ELEVENLABS_API_KEY=
PORTIVE_INBOUND_AGENT_ID=agent_YOUR_INBOUND_SALES_AVA
PORTIVE_OUTBOUND_AGENT_ID=agent_YOUR_OUTBOUND_SALES_AVA
PORTIVE_SALES_NUMBER=+13103318914
