# Backend-only secret. Legacy Supabase service-role JWT OR new sb_secret_ key.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=PASTE_SERVER_ONLY_KEY

# Create with: python3 -c 'import secrets;print(secrets.token_urlsafe(40))'
PORTIVE_TOOL_API_KEY=GENERATE_YOUR_RANDOM_SECRET

# Required only for send_portive_overview
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Bare address of the Gmail account authorized locally (no display name).
GMAIL_SENDER_EMAIL=
# Optional; defaults to GMAIL_SENDER_EMAIL.
GMAIL_REPLY_TO=
BUSINESS_POSTAL_ADDRESS=YOUR_REAL_BUSINESS_POSTAL_ADDRESS
PUBLIC_BASE_URL=https://YOUR_HTTPS_BACKEND_DOMAIN
UNSUBSCRIBE_SIGNING_SECRET=GENERATE_ANOTHER_RANDOM_SECRET
